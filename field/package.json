{
  "name": "fieldpilot",
  "version": "1.0.0",
  "private": true,
  "description": "FieldPilot — a voice-first agentic copilot for field technicians (Agora Conversational AI + Murf Falcon TTS + LLM tool calling + RAG + MCP).",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx server/watchtower.test.ts && tsx server/selftest.ts",
    "mcp:inspect": "npx -y @modelcontextprotocol/inspector@2.16.0",
    "smoke": "tsx server/smoke.ts",
    "mcp:list": "npx -y @modelcontextprotocol/inspector@2.16.0 --cli http://localhost:8787/mcp --transport http --method tools/list",
    "rehearse": "tsx server/rehearse.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "agora-rtc-sdk-ng": "4.24.10",
    "agora-token": "2.0.7",
    "dotenv": "^16.4.7",
    "express": "5.3.0",
    "lucide-react": "1.77.0",
    "motion": "14.14.0",
    "openai": "7.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
