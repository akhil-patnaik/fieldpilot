# Everything below is OPTIONAL for a first run: with no keys, FieldPilot starts with the scripted
# "backup brain" and runs the full demo story by text or Direct voice (browser speech).

# ─── Server ───────────────────────────────────────────────────────────────
PORT=8787
# 1 = force the scripted backup brain, 0 = never use it. Blank = automatic (on when no LLM is configured).
BACKUP_MODE=
# Public HTTPS URL that Agora's cloud can reach (ngrok / cloudflared tunnel to PORT).
# Required only for Agora voice mode — the Agora agent calls ${PUBLIC_URL}/llm/chat/completions
PUBLIC_URL=

# ─── LLM (any OpenAI-compatible endpoint) ────────────────────────────────
# OpenAI:    https://api.openai.com/v1                       model e.g. gpt-4.1-mini / gpt-4o
# Groq:      https://api.groq.com/openai/v1                  model e.g. llama-3.3-70b-versatile
# Gemini:    https://generativelanguage.googleapis.com/v1beta/openai/   model e.g. gemini-2.5-flash
# Anthropic: https://api.anthropic.com/v1/                   model e.g. claude-sonnet-5-5
# Ollama:    http://localhost:11434/v1                       model e.g. qwen2.5:14b
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# ─── RAG embeddings (optional) ───────────────────────────────────────────
# Hybrid retrieval (BM25 + embeddings) when set; BM25-only otherwise (no extra key needed).
# Defaults to the LLM provider; auto-enabled with text-embedding-3-small when that provider is OpenAI.
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# ─── Agora Conversational AI (console.agora.io) ──────────────────────────
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Optional: RESTful customer key/secret. If blank we authenticate with a ConvoAI token.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
# Agora ASR language
AGORA_ASR_LANGUAGE=en-US

# ─── Murf AI Falcon TTS (murf.ai/api) ───────────────────────────────────
MURF_API_KEY=
MURF_VOICE_ID=Matthew
MURF_LOCALE=en-US
MURF_MODEL=falcon-2.1

# ─── Demo knobs ──────────────────────────────────────────────────────────
# Technician purchase approval limit (USD). Orders above this route to manager approval.
APPROVAL_LIMIT_USD=750
# Inject transient ERP failures to showcase retry/recovery (0..1 probability)
CHAOS_FAILURE_RATE=0
